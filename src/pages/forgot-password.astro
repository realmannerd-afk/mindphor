---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout title="Forgot Password">
  <div class="relative min-h-[100dvh] flex flex-col items-center justify-center bg-bg-base p-6">
    <a href="/login" class="absolute top-4 left-4 md:top-4 md:left-6 flex items-center gap-2 text-[13px] font-medium text-text-secondary hover:text-text-primary transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to login
    </a>
    
    <div class="w-full max-w-[400px]">
      <div class="text-center mb-8 flex flex-col items-center">
        <a href="/" class="group flex items-baseline gap-0 transition-opacity cursor-pointer mb-3">
          <span class="text-[20px] font-medium text-text-primary tracking-tight transition-opacity duration-200 group-hover:opacity-70">Mindphor</span>
        </a>
        <h1 class="text-xl font-medium text-text-primary mb-1">
          Reset your password
        </h1>
        <p class="text-[13px] text-text-secondary">
          Enter your email address and we'll send you a link to reset your password.
        </p>
      </div>

      <div class="bg-bg-surface border border-border-default rounded-[16px] p-6 shadow-sm">
        <form class="space-y-4" id="forgot-password-form">
          <div>
            <label class="block text-[13px] font-medium text-text-primary mb-1.5" for="email">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full bg-bg-base border border-border-default rounded-md px-3 py-2 text-[14px] text-text-primary focus:outline-none focus:border-border-strong focus:ring-1 focus:ring-border-strong transition-all shadow-sm"
              placeholder="name@company.com"
              required
            />
          </div>

          <button
            id="forgot-submit"
            type="submit"
            class="w-full mt-6 h-[40px] flex items-center justify-center bg-text-primary text-bg-base text-[14px] font-medium rounded-full hover:opacity-90 transition-opacity shadow-sm"
          >
            Send Reset Link
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('forgot-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      const submitBtn = document.getElementById('forgot-submit') as HTMLButtonElement;
      
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.5';

      try {
        const response = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          body: formData,
        });
        
        if (response.ok) {
          // Redirect to a check your email page or show toast
          window.showToast?.('Password reset link sent to your email', 'success');
          setTimeout(() => {
            window.location.href = '/login';
          }, 3000);
        } else {
          const data = await response.json();
          window.showToast?.(data.error || 'Failed to send reset link', 'error');
        }
      } catch (error) {
        window.showToast?.('An error occurred. Please try again.', 'error');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  </script>
</RootLayout>
