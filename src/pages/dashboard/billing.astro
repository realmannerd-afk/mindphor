---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getSupabaseClient } from '../../lib/supabase';
import { loadEnv } from 'vite';

const supabase = getSupabaseClient(Astro.cookies);
const { data: userData } = await supabase.auth.getUser();

if (!userData?.user) {
  return Astro.redirect('/login');
}

const paddleToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN;
const starterPrice = import.meta.env.PADDLE_STARTER_PRICE_ID;
const growthPrice = import.meta.env.PADDLE_GROWTH_PRICE_ID;
const proPrice = import.meta.env.PADDLE_PRO_PRICE_ID;

// Fetch the user's latest subscription from the database
const { data: subs } = await supabase
  .from('subscriptions')
  .select('plan, status, current_period_end, paddle_subscription_id')
  .eq('user_id', userData.user.id)
  .order('created_at', { ascending: false })
  .limit(1);

const sub = subs?.[0] || null;

const planName = sub?.plan || null;
const isActive = sub?.status === 'active' || sub?.status === 'trialing';
const isStarter = planName === 'starter' && isActive;
const growthActive = planName === 'growth' && isActive;
const isPro = planName === 'pro' && isActive;


const env = loadEnv(import.meta.env.MODE, process.cwd(), '');
const PADDLE_API_KEY = import.meta.env.PADDLE_API_KEY || process.env.PADDLE_API_KEY || env.PADDLE_API_KEY;

let scheduledChange = null;
if (sub?.paddle_subscription_id) {
  if (PADDLE_API_KEY) {
    const apiUrl = import.meta.env.PADDLE_API_URL || process.env.PADDLE_API_URL;
    if (!apiUrl) throw new Error("PADDLE_API_URL environment variable is missing.");
    const res = await fetch(`${apiUrl}/subscriptions/${sub.paddle_subscription_id}`, {
      headers: { Authorization: `Bearer ${PADDLE_API_KEY}` }
    });
    if (res.ok) {
      const pData = await res.json();
      scheduledChange = pData.data?.scheduled_change;
    }
  }
}
---

<DashboardLayout title="Billing & Plans">
  <div class="w-full max-w-[1200px] pb-8 pt-2">
    <div class="mb-8">
      <h1 class="text-[clamp(18px,2vw,24px)] font-semibold text-text-primary leading-tight tracking-tight mb-2">Manage your subscription</h1>
      <p class="text-[13px] text-text-secondary">Upgrade your plan to track more apps, monitor competitors, and unlock real-time anomaly alerts.</p>
    </div>

    {scheduledChange && (
      <div class="mb-8 flex items-center justify-between py-3 px-4 bg-bg-base border border-border-default rounded-[8px]">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-accent animate-pulse"></div>
          <p class="text-[13px] text-text-primary">
            <strong class="font-semibold mr-1">Scheduled:</strong>
            {scheduledChange.action === 'cancel' 
              ? `Your subscription will end on ${new Date(scheduledChange.effective_at).toLocaleDateString()}.` 
              : `Your plan will change to a different tier on ${new Date(scheduledChange.effective_at).toLocaleDateString()}.`}
          </p>
        </div>
        {scheduledChange.action === 'cancel' && (
          <button id="btn-revoke-cancel" class="px-3 py-1.5 rounded-full text-[12px] font-medium text-text-primary bg-bg-subtle border border-border-default hover:bg-border-default transition-colors flex-shrink-0">
            Resume Subscription
          </button>
        )}
      </div>
    )}

    <!-- Client-side fake banner for deferred plan changes -->
    <div id="client-scheduled-banner" class="hidden mb-8 flex items-center justify-between py-3 px-4 bg-bg-base border border-border-default rounded-[8px]">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 rounded-full bg-accent animate-pulse"></div>
        <p class="text-[13px] text-text-primary">
          <strong class="font-semibold mr-1">Scheduled:</strong>
          <span id="client-scheduled-text"></span>
        </p>
      </div>
      <button id="btn-undo-plan-change" class="px-3 py-1.5 rounded-full text-[12px] font-medium text-text-primary bg-bg-subtle border border-border-default hover:bg-border-default transition-colors flex-shrink-0">
        Undo
      </button>
    </div>

    <!-- Current Subscription Details -->
    <!-- Current Subscription Details -->
    {sub && (
      <div class="mb-12 p-8 bg-bg-base border border-border-default rounded-[16px]">
        <h2 class="text-[16px] font-semibold text-text-primary mb-8 flex items-center gap-2.5">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"></path></svg>
          Current Subscription Details
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0 text-accent">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"></path></svg>
            </div>
            <div>
              <div class="text-[12px] text-text-muted mb-0.5 font-medium">Active Plan</div>
              <div class="text-[15px] font-semibold text-text-primary capitalize">{sub.plan}</div>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center flex-shrink-0 text-green-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <div class="text-[12px] text-text-muted mb-0.5 font-medium">Status</div>
              <div class="text-[15px] font-semibold text-text-primary capitalize flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full ${sub.status === 'active' ? 'bg-[#10b981]' : (sub.status === 'canceled' ? 'bg-[#ef4444]' : 'bg-[#f59e0b]')}`}></span>
                {sub.status}
              </div>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center flex-shrink-0 text-blue-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"></path></svg>
            </div>
            <div>
              <div class="text-[12px] text-text-muted mb-0.5 font-medium">Billing Period Ends</div>
              <div class="text-[15px] font-semibold text-text-primary">
                {sub.current_period_end ? new Date(sub.current_period_end).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A'}
              </div>
            </div>
          </div>

        </div>
        
        {sub.status !== 'canceled' && (!scheduledChange || scheduledChange.action !== 'cancel') && (
          <div class="mt-6 pt-6 border-t border-border-default flex justify-end">
            <button 
              id="btn-cancel-sub"
              class="text-[#ef4444] text-[13px] font-medium px-5 py-2.5 border border-[#ef4444]/30 rounded-full hover:bg-[#ef4444]/10 transition-colors"
            >
              Cancel Subscription
            </button>
          </div>
        )}
      </div>
    )}

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      
      <!-- Starter Card -->
      <div class="flex flex-col h-full bg-bg-base border border-border-default rounded-[12px] p-8 text-left transition-all hover:border-text-primary/20 relative">
        {isStarter && <div class="absolute -top-3 left-8 bg-text-primary text-bg-base text-[10px] uppercase tracking-wider font-semibold px-3 py-1 rounded-full">Current Plan</div>}
        <div class="text-[11px] uppercase tracking-wider text-text-muted font-mono font-semibold mb-2">Starter</div>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-[32px] font-semibold text-text-primary leading-none">$12</span>
          <span class="text-[12px] text-text-muted mb-1">/mo</span>
        </div>
        <ul class="text-[13px] text-text-secondary space-y-3.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-muted mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>1 App tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-muted mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Unlimited App Store & Play Store reviews</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-muted mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>1 Competitor tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-muted mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Basic sentiment metrics</span>
          </li>
        </ul>
        <button
          id="btn-starter"
          disabled={isStarter}
          class={`mt-auto block w-full border rounded-full py-3 text-[13px] font-medium transition-colors text-center ${isStarter ? 'bg-bg-subtle text-text-muted border-transparent cursor-not-allowed' : 'bg-transparent border-border-default text-text-primary hover:bg-bg-elevated'}`}
        >
          {sub?.plan === 'starter' && sub?.status === 'canceled' ? 'Resubscribe to Starter' : (isStarter ? 'Current Plan' : 'Downgrade to Starter')}
        </button>
      </div>

      <!-- Growth Card -->
      <div class="flex flex-col h-full bg-bg-base border border-accent/30 rounded-[12px] p-8 text-left relative">
        {growthActive ? 
          <div class="absolute -top-3 left-8 bg-text-primary text-bg-base text-[10px] uppercase tracking-wider font-semibold px-3 py-1 rounded-full">Current Plan</div>
          : 
          <div class="absolute -top-3 left-8 bg-accent text-bg-base text-[10px] uppercase tracking-wider font-semibold px-3 py-1 rounded-full">Most Popular</div>
        }
        <div class="text-[11px] uppercase tracking-wider text-text-muted font-mono font-semibold mb-2">Growth</div>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-[32px] font-semibold text-text-primary leading-none">$29</span>
          <span class="text-[12px] text-text-muted mb-1">/mo</span>
        </div>
        <ul class="text-[13px] text-text-secondary space-y-3.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Up to 3 Apps tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Unlimited App Store & Play Store reviews</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Up to 5 Competitors tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Real-time anomaly alerts</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>AI-generated action plans</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Slack & Discord Webhooks</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Custom HMAC Webhooks</span>
          </li>
        </ul>
        <button
          id="btn-growth"
          disabled={growthActive}
          class={`mt-auto block w-full rounded-full py-3 text-[13px] font-medium transition-colors text-center ${growthActive ? 'bg-bg-subtle text-text-muted border border-transparent cursor-not-allowed' : 'bg-[#000000] text-white hover:bg-[#333333]'}`}
        >
          {sub?.plan === 'growth' && sub?.status === 'canceled' ? 'Resubscribe to Growth' : (growthActive ? 'Current Plan' : (isPro ? 'Downgrade to Growth' : 'Upgrade to Growth'))}
        </button>
      </div>

      <!-- Pro Card -->
      <div class="flex flex-col h-full bg-bg-base border border-border-default rounded-[12px] p-8 text-left transition-all hover:border-text-primary/20 relative">
        {isPro && <div class="absolute -top-3 left-8 bg-text-primary text-bg-base text-[10px] uppercase tracking-wider font-semibold px-3 py-1 rounded-full">Current Plan</div>}
        <div class="text-[11px] uppercase tracking-wider text-text-muted font-mono font-semibold mb-2">Pro</div>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-[32px] font-semibold text-text-primary leading-none">$79</span>
          <span class="text-[12px] text-text-muted mb-1">/mo</span>
        </div>
        <ul class="text-[13px] text-text-secondary space-y-3.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Up to 10 Apps tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Unlimited App Store & Play Store reviews</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Up to 15 Competitors tracked</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Real-time anomaly alerts</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>AI-generated action plans</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Slack & Discord Webhooks</span>
          </li>

          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Custom HMAC Webhooks</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-text-primary mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Unlimited API Key Access</span>
          </li>
        </ul>
        <button
          id="btn-pro"
          disabled={isPro}
          class={`mt-auto block w-full border rounded-full py-3 text-[13px] font-medium transition-colors text-center ${isPro ? 'bg-bg-subtle text-text-muted border-transparent cursor-not-allowed' : 'bg-transparent border-border-default text-text-primary hover:bg-bg-elevated'}`}
        >
          {sub?.plan === 'pro' && sub?.status === 'canceled' ? 'Resubscribe to Pro' : (isPro ? 'Current Plan' : 'Upgrade to Pro')}
        </button>
      </div>

    </div>
  </div>

  <div id="cancel-modal" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="cancel-modal-bg"></div>
    <div class="relative bg-bg-base border border-border-default rounded-[16px] shadow-2xl p-6 w-full max-w-md transform scale-95 transition-transform duration-200" id="cancel-modal-card">
      <div class="flex items-center gap-3 mb-4 text-[#ef4444]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <h3 class="text-[18px] font-semibold text-text-primary">Cancel Subscription</h3>
      </div>
      <p class="text-[14px] text-text-secondary mb-8 leading-relaxed">
        Are you sure you want to cancel your subscription? You will retain access to all features until the end of your current billing period.
      </p>
      <div class="flex justify-end gap-3">
        <button id="btn-modal-close" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-text-primary hover:bg-bg-subtle transition-colors">
          Keep Plan
        </button>
        <button id="btn-cancel-confirm" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-white bg-[#dc2626] hover:bg-[#b91c1c] transition-colors">
          Yes, Cancel Subscription
        </button>
      </div>
    </div>
  </div>

  <!-- Undo Confirmation Modal -->
  <div id="undo-modal" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="undo-modal-bg"></div>
    <div class="relative bg-bg-base border border-border-default rounded-[16px] shadow-2xl p-6 w-full max-w-md transform scale-95 transition-transform duration-200" id="undo-modal-card">
      <div class="flex items-center gap-3 mb-4 text-text-primary">
        <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
        <h3 class="text-[18px] font-semibold text-text-primary">Undo Scheduled Change</h3>
      </div>
      <p class="text-[14px] text-text-secondary mb-8 leading-relaxed">
        Are you sure you want to undo this scheduled change? Your subscription will immediately revert to its previous state.
      </p>
      <div class="flex justify-end gap-3">
        <button id="btn-undo-close" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-text-primary hover:bg-bg-subtle transition-colors">
          Keep Change
        </button>
        <button id="btn-undo-confirm" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-white bg-accent hover:bg-accent/90 transition-colors">
          Yes, Undo
        </button>
      </div>
    </div>
  </div>

  <!-- Plan Change Modal -->
  <div id="plan-modal" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="plan-modal-bg"></div>
    <div class="relative bg-bg-base border border-border-default rounded-[16px] shadow-2xl p-6 w-full max-w-md transform scale-95 transition-transform duration-200" id="plan-modal-card">
      <div class="flex items-center gap-3 mb-4 text-text-primary">
        <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
        <h3 class="text-[18px] font-semibold text-text-primary">Change Subscription Plan</h3>
      </div>
      <p class="text-[14px] text-text-secondary mb-8 leading-relaxed">
        You are about to schedule a change to your subscription. Because this change is deferred, you will keep your current access and will not be billed today. 
        <br/><br/>
        The new plan will automatically take effect on <strong class="text-text-primary font-medium">{sub?.current_period_end ? new Date(sub.current_period_end).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : 'your next renewal date'}</strong>.
      </p>
      <div class="flex justify-end gap-3">
        <button id="btn-plan-close" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-text-primary hover:bg-bg-subtle transition-colors">
          Cancel
        </button>
        <button id="btn-plan-confirm" class="px-5 py-2.5 rounded-full text-[13px] font-medium text-white bg-accent hover:bg-accent/90 transition-colors">
          Confirm Change
        </button>
      </div>
    </div>
  </div>

  <script src="https://cdn.paddle.com/paddle/v2/paddle.js" is:inline></script>
  <script define:vars={{
    paddleToken,
    paddleEnv: import.meta.env.PUBLIC_PADDLE_ENV,
    starterPrice,
    growthPrice,
    proPrice,
    userId: userData.user.id,
    hasSub: !!sub && sub.status !== 'canceled',
    currentPlanName: planName,
    formattedEndDate: sub?.current_period_end ? new Date(sub.current_period_end).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : 'your next renewal date'
  }}>
    if (paddleEnv === 'sandbox') {
      Paddle.Environment.set('sandbox');
    }
    
    Paddle.Initialize({ 
      token: paddleToken,
      eventCallback: function(data) {
        if (data.name === "checkout.completed") {
          setTimeout(() => window.location.reload(), 2000); 
        }
      }
    });

    const checkoutOptions = {
      customData: { supabase_user_id: userId }
    };

    // Setup Plan Change Modal
    const planModal = document.getElementById('plan-modal');
    const planModalCard = document.getElementById('plan-modal-card');
    let pendingPriceId = null;
    let pendingButton = null;
    let pendingOriginalText = null;
    let pendingPlanName = '';
    
    function showPlanModal(priceId, btn, targetPlanName) {
      if (!planModal) return;
      pendingPriceId = priceId;
      pendingButton = btn;
      pendingOriginalText = btn.innerText;
      pendingPlanName = targetPlanName;
      planModal.classList.remove('opacity-0', 'pointer-events-none');
      planModalCard?.classList.remove('scale-95');
      planModalCard?.classList.add('scale-100');
    }
    
    function hidePlanModal() {
      if (!planModal) return;
      planModal.classList.add('opacity-0', 'pointer-events-none');
      planModalCard?.classList.remove('scale-100');
      planModalCard?.classList.add('scale-95');
      pendingPriceId = null;
    }

    document.getElementById('plan-modal-bg')?.addEventListener('click', hidePlanModal);
    document.getElementById('btn-plan-close')?.addEventListener('click', hidePlanModal);

    document.getElementById('btn-plan-confirm')?.addEventListener('click', async (e) => {
      if (!pendingPriceId || !pendingButton) return;
      
      const btn = pendingButton;
      const confirmBtn = e.currentTarget;
      const confirmOriginalText = confirmBtn.innerText;
      
      btn.innerText = 'Processing...';
      btn.disabled = true;
      confirmBtn.innerText = 'Processing...';
      confirmBtn.disabled = true;

      try {
        const res = await fetch('/api/billing/manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update', priceId: pendingPriceId })
        });
        const data = await res.json();
        
        if (!res.ok) {
          alert('Error updating plan: ' + data.error);
          btn.innerText = pendingOriginalText;
          btn.disabled = false;
          confirmBtn.innerText = confirmOriginalText;
          confirmBtn.disabled = false;
          hidePlanModal();
        } else {
          let prevPriceId = null;
          if (currentPlanName === 'starter') prevPriceId = starterPrice;
          if (currentPlanName === 'growth') prevPriceId = growthPrice;
          if (currentPlanName === 'pro') prevPriceId = proPrice;
          if (prevPriceId) localStorage.setItem('scheduled_plan_prev_price', prevPriceId);
          
          localStorage.setItem('scheduled_plan_text', `Your plan will change to ${pendingPlanName} on ${formattedEndDate}.`);
          window.location.reload();
        }
      } catch (err) {
        alert('Failed to update plan.');
        btn.innerText = pendingOriginalText;
        btn.disabled = false;
        confirmBtn.innerText = confirmOriginalText;
        confirmBtn.disabled = false;
        hidePlanModal();
      }
    });

    async function handlePlanChange(priceId, btn, targetPlanName) {
      if (!hasSub) {
        Paddle.Checkout.open({ items: [{ priceId, quantity: 1 }], ...checkoutOptions });
        return;
      }
      
      showPlanModal(priceId, btn, targetPlanName);
    }

    document.getElementById('btn-starter')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (starterPrice) handlePlanChange(starterPrice, e.currentTarget, 'Starter');
    });

    document.getElementById('btn-growth')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (growthPrice) handlePlanChange(growthPrice, e.currentTarget, 'Growth');
    });

    document.getElementById('btn-pro')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (proPrice) handlePlanChange(proPrice, e.currentTarget, 'Pro');
    });

    const cancelModal = document.getElementById('cancel-modal');
    const cancelModalCard = document.getElementById('cancel-modal-card');
    
    function showCancelModal() {
      if (!cancelModal) return;
      cancelModal.classList.remove('opacity-0', 'pointer-events-none');
      cancelModalCard?.classList.remove('scale-95');
      cancelModalCard?.classList.add('scale-100');
    }
    
    function hideCancelModal() {
      if (!cancelModal) return;
      cancelModal.classList.add('opacity-0', 'pointer-events-none');
      cancelModalCard?.classList.remove('scale-100');
      cancelModalCard?.classList.add('scale-95');
    }

    document.getElementById('btn-cancel-sub')?.addEventListener('click', (e) => {
      e.preventDefault();
      showCancelModal();
    });

    // Check for client-side scheduled banner
    document.addEventListener('DOMContentLoaded', () => {
      const scheduledText = localStorage.getItem('scheduled_plan_text');
      if (scheduledText) {
        const banner = document.getElementById('client-scheduled-banner');
        const textSpan = document.getElementById('client-scheduled-text');
        if (banner && textSpan) {
          textSpan.innerText = scheduledText;
          banner.classList.remove('hidden');
        }
      }
    });
    
    // Undo Modal Logic
    const undoModal = document.getElementById('undo-modal');
    const undoModalCard = document.getElementById('undo-modal-card');
    let undoActionType = null;
    
    function showUndoModal(type) {
      if (!undoModal) return;
      undoActionType = type;
      undoModal.classList.remove('opacity-0', 'pointer-events-none');
      undoModalCard?.classList.remove('scale-95');
      undoModalCard?.classList.add('scale-100');
    }
    
    function hideUndoModal() {
      if (!undoModal) return;
      undoModal.classList.add('opacity-0', 'pointer-events-none');
      undoModalCard?.classList.remove('scale-100');
      undoModalCard?.classList.add('scale-95');
      undoActionType = null;
    }

    document.getElementById('undo-modal-bg')?.addEventListener('click', hideUndoModal);
    document.getElementById('btn-undo-close')?.addEventListener('click', hideUndoModal);
    
    document.getElementById('btn-revoke-cancel')?.addEventListener('click', (e) => {
      e.preventDefault();
      showUndoModal('revoke_cancel');
    });

    document.getElementById('btn-undo-plan-change')?.addEventListener('click', (e) => {
      e.preventDefault();
      showUndoModal('undo_plan');
    });
    
    document.getElementById('btn-undo-confirm')?.addEventListener('click', async (e) => {
      e.preventDefault();
      const btn = e.currentTarget;
      
      if (undoActionType === 'revoke_cancel') {
        btn.innerText = 'Processing...';
        btn.disabled = true;
        try {
          const res = await fetch('/api/billing/manage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'revoke_cancel' })
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to resume subscription.');
            btn.innerText = 'Yes, Undo';
            btn.disabled = false;
            hideUndoModal();
          }
        } catch (err) {
          alert('Failed to resume subscription.');
          btn.innerText = 'Yes, Undo';
          btn.disabled = false;
          hideUndoModal();
        }
      } else if (undoActionType === 'undo_plan') {
        const prevPriceId = localStorage.getItem('scheduled_plan_prev_price');
        if (!prevPriceId) {
          localStorage.removeItem('scheduled_plan_text');
          window.location.reload();
          return;
        }
        
        btn.innerText = 'Processing...';
        btn.disabled = true;
        
        try {
          const res = await fetch('/api/billing/manage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'update', priceId: prevPriceId })
          });
          if (res.ok) {
            localStorage.removeItem('scheduled_plan_text');
            localStorage.removeItem('scheduled_plan_prev_price');
            window.location.reload();
          } else {
            alert('Failed to undo plan change.');
            btn.innerText = 'Yes, Undo';
            btn.disabled = false;
            hideUndoModal();
          }
        } catch (err) {
          alert('Failed to undo plan change.');
          btn.innerText = 'Yes, Undo';
          btn.disabled = false;
          hideUndoModal();
        }
      }
    });

    document.getElementById('cancel-modal-bg')?.addEventListener('click', hideCancelModal);
    document.getElementById('btn-modal-close')?.addEventListener('click', hideCancelModal);

    document.getElementById('btn-modal-confirm')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const originalText = btn.innerText;
      btn.innerText = 'Canceling...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/billing/manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'cancel' })
        });
        const data = await res.json();
        
        if (!res.ok) {
          alert('Error canceling subscription: ' + data.error);
          btn.innerText = originalText;
          btn.disabled = false;
          hideCancelModal();
        } else {
          window.location.reload();
        }
      } catch (err) {
        alert('Failed to cancel subscription.');
        btn.innerText = originalText;
        btn.disabled = false;
        hideCancelModal();
      }
    });
  </script>
</DashboardLayout>
