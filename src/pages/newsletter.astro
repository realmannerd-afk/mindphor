---
import RootLayout from "../layouts/RootLayout.astro";
import PublicNav from "../components/layout/PublicNav.astro";
import NewsletterForm from "../components/islands/NewsletterForm.svelte";
import { getSupabaseClient } from '../lib/supabase';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const hasSessionCookie = cookieHeader.includes('sb-');

let userData = null;
if (hasSessionCookie) {
  const supabase = getSupabaseClient(Astro.cookies);
  const { data } = await supabase.auth.getUser();
  userData = data;
}
---

<RootLayout title="Newsletter - Mindphor">
  <PublicNav />

  <div class="w-full min-h-[75vh] flex flex-col items-center justify-center pt-[100px] pb-12 px-[clamp(20px,5vw,80px)] relative">
    <!-- Optional background accent -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg h-[400px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>
    
    <div class="w-full max-w-3xl">
      <NewsletterForm client:load />
    </div>
  </div>

  <!-- FOOTER -->
  <div class="w-full bg-bg-subtle pt-16 pb-6 border-t border-border-faint">
    <footer class="max-w-[1400px] mx-auto px-[clamp(20px,5vw,80px)]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 mb-12">
        <div class="lg:col-span-5">
          <a href="/" class="group flex items-baseline gap-0 cursor-pointer">
            <span class="font-semibold text-text-primary text-[15px] tracking-tight transition-opacity duration-200 group-hover:opacity-70">Mindphor</span>
          </a>
          <p class="mt-4 text-[13px] text-text-secondary max-w-[240px] leading-relaxed">
            Play Store feedback analytics (App Store coming soon) and automated competitor intelligence for scaling apps.
          </p>
        </div>

        <div class="lg:col-span-7">
          <h4 class="text-[11px] font-semibold text-text-primary uppercase tracking-wider mb-4">Legal</h4>
          <ul class="space-y-2 text-[13px] text-text-secondary">
            <li><a href="/privacy" class="hover:text-text-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-text-primary transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      
      <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[12px] text-text-muted border-t border-border-faint">
        <div>&copy; 2026 Mindphor Intelligence. All rights reserved.</div>
      </div>
    </footer>
  </div>
</RootLayout>
